<!-- 回放可视化：显示场景(边界+障碍物) + 起终点车身足迹+朝向，不做规划 -->
<launch>
  <arg name="csv_file" default="$(find condition_planner)/config/trajectory_v1.csv"/>

  <!-- 只做场景可视化的轻量节点 -->
  <node name="replay_viz" pkg="condition_planner" type="replay_viz_node" output="screen">
    <rosparam command="load" file="$(find condition_planner)/config/planner.yaml"/>
    <param name="env_file" value="$(find condition_planner)/config/env.json"/>
    <param name="csv_file" value="$(arg csv_file)"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find condition_planner)/config/rviz.rviz"/>
</launch>
