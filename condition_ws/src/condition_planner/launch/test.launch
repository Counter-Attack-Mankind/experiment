<launch>
  <arg name="use_ecc" default="false"/>
  <arg name="liom_csv_file" default="$(find condition_planner)/config/trajectory_v1.csv"/>

  <node name="condition_planner" pkg="condition_planner" type="condition_planner_node" output="screen">
    <rosparam command="load" file="$(find condition_planner)/config/planner.yaml"/>
    <param name="env_file" value="$(find condition_planner)/config/env.json"/>
    <param name="use_ecc" value="$(arg use_ecc)"/>
    <param name="liom_csv_file" value="$(arg liom_csv_file)"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find condition_planner)/config/rviz.rviz" />
</launch>
